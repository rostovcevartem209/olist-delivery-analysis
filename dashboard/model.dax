// Создавать объекты в Power BI Desktop по одному.
// Вычисляемый столбец в таблице mart order_delivery.
Дата покупки =
DATE(
    YEAR('mart order_delivery'[purchased_at]),
    MONTH('mart order_delivery'[purchased_at]),
    DAY('mart order_delivery'[purchased_at])
)

// Вычисляемая таблица. Полные годы по диапазону дат покупки.
// Для текущих данных ожидается 1096 дат с 2016-01-01 по 2018-12-31.
Календарь =
CALENDAR(
    DATE(YEAR(MIN('mart order_delivery'[purchased_at])), 1, 1),
    DATE(YEAR(MAX('mart order_delivery'[purchased_at])), 12, 31)
)

// Столбец и календарь созданы пользователем.
// По скриншоту подтверждена активная связь Календарь[Date] (1)
// к mart order_delivery[Дата покупки] (*) с одним направлением фильтра.

// Следующие столбцы создавать в таблице Календарь.
// Формат yyyy-MM обеспечивает хронологическую сортировку текста.
Месяц =
FORMAT('Календарь'[Date], "yyyy-MM")

Период сравнения =
'Календарь'[Date] >= DATE(2017, 1, 1)
    && 'Календарь'[Date] < DATE(2018, 8, 1)

// Два столбца и месячный график созданы пользователем.
// Для графика доли просрочек фильтр Период сравнения = TRUE
// применяется только к визуальному элементу.
// Подсказка марта 2018 сверена с SQL по скриншоту:
// 7003 пригодных заказа, 1328 просрочек, доля 18.96%.

// Вычисляемый столбец в mart order_delivery.
// Для delay_group установить Сортировать по столбцу → Порядок задержки.
// Добавление и порядок групп на графике подтверждены по скриншоту.
Порядок задержки =
SWITCH(
    TRUE(),
    ISBLANK('mart order_delivery'[deviation_days]), BLANK(),
    'mart order_delivery'[deviation_days] <= 0, 0,
    'mart order_delivery'[deviation_days] <= 3, 1,
    'mart order_delivery'[deviation_days] <= 7, 2,
    'mart order_delivery'[deviation_days] <= 14, 3,
    4
)

// Вычисляемый столбец в mart order_delivery для сравнения двух групп.
// Создание и таблица сравнения подтверждены по скриншоту.
Группа доставки =
IF(
    'mart order_delivery'[is_delivery_eligible],
    IF(
        'mart order_delivery'[is_late],
        "С опозданием",
        "Вовремя или раньше"
    )
)
