// Создавать меры в Power BI Desktop по одной.
// Имя импортированной таблицы в текущем отчёте — mart order_delivery.
// Все семь мер ниже сверены пользователем с SQL по карточкам.

Всего заказов = COUNTROWS('mart order_delivery')

// Карточки исключений проверены: полный период 2971/2963/8;
// март 2018 — 208/208/0 (всего / по статусу / по данным).
Исключённые заказы =
COALESCE(
    CALCULATE(
        COUNTROWS('mart order_delivery'),
        KEEPFILTERS('mart order_delivery'[is_delivery_eligible] = FALSE())
    ),
    0
)

Исключено по статусу =
COALESCE(
    CALCULATE(
        COUNTROWS('mart order_delivery'),
        KEEPFILTERS('mart order_delivery'[exclusion_reason] = "status_not_delivered")
    ),
    0
)

// Все причины качества доставки после исключения по статусу.
// В текущем полном наборе это 8 заказов без обязательных дат.
Исключено по данным доставки =
[Исключённые заказы] - [Исключено по статусу]

Пригодные заказы =
CALCULATE(
    COUNTROWS('mart order_delivery'),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

Просроченные заказы =
CALCULATE(
    COUNTROWS('mart order_delivery'),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_late] = TRUE()
)

// Формат меры — процент, два десятичных знака.
Доля просрочек =
DIVIDE(
    [Просроченные заказы],
    [Пригодные заказы]
)

// Сверены медиана доставки 10, P90 23, медианная задержка 7 дней.
// Формат — число. Единица измерения — календарные дни.
Медиана доставки, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delivery_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

P90 доставки, дней =
CALCULATE(
    PERCENTILE.INC('mart order_delivery'[delivery_days], 0.9),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

Медианная задержка, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delay_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_late] = TRUE()
)

// Отметка малого объёма в контексте штата, категории или продавца.
// Мера добавлена в таблицу и подсказки. Для AP сверены 67 заказов
// и отметка Менее 100 заказов. Медианная задержка отображается с одним знаком.
Объём выборки =
IF(
    [Пригодные заказы] < 100,
    "Менее 100 заказов",
    "От 100 заказов"
)

// Доля просрочек штата в просрочках всех штатов.
// Остальные фильтры отчёта сохраняются.
// Сверены SP 27.85%, RJ 22.88%, MG 7.94% и итог 100%.
Вклад в просрочки =
DIVIDE(
    [Просроченные заказы],
    CALCULATE(
        [Просроченные заказы],
        REMOVEFILTERS('mart order_delivery'[customer_state])
    )
)

// Накопленный вклад штатов по числу просрочек по убыванию.
// При совпадении количества порядок определяется кодом штата по возрастанию.
// Сверены SP 27.85%, RJ 50.73%, MG 58.68%, BA 64.74% и итог 100%.
Накопленный вклад =
VAR CurrentState =
    SELECTEDVALUE('mart order_delivery'[customer_state])
VAR CurrentLateOrders =
    [Просроченные заказы]
VAR StateCounts =
    CALCULATETABLE(
        ADDCOLUMNS(
            VALUES('mart order_delivery'[customer_state]),
            "LateOrders", [Просроченные заказы]
        ),
        REMOVEFILTERS('mart order_delivery'[customer_state])
    )
VAR CumulativeLateOrders =
    SUMX(
        FILTER(
            StateCounts,
            [LateOrders] > CurrentLateOrders
                || (
                    [LateOrders] = CurrentLateOrders
                        && 'mart order_delivery'[customer_state] <= CurrentState
                )
        ),
        [LateOrders]
    )
RETURN
    IF(
        ISINSCOPE('mart order_delivery'[customer_state]),
        DIVIDE(
            CumulativeLateOrders,
            CALCULATE(
                [Просроченные заказы],
                REMOVEFILTERS('mart order_delivery'[customer_state])
            )
        ),
        [Вклад в просрочки]
    )

// Основной анализ продавцов, пригодные заказы с одним продавцом.
// TREATAS передаёт список заказов выбранного продавца в основную витрину.
// Сверены общий итог 95195 заказов, 6521 просрочка и лидер 1673/168.
Заказы продавца =
CALCULATE(
    [Пригодные заказы],
    'mart order_delivery'[seller_count] = 1,
    TREATAS(
        VALUES('mart order_seller'[order_id]),
        'mart order_delivery'[order_id]
    )
)

Просрочки продавца =
COALESCE(
    CALCULATE(
        [Заказы продавца],
        'mart order_delivery'[is_late] = TRUE()
    ),
    0
)

// Формат — процент, два десятичных знака.
// Сверены лидер 10.04% и общий итог 6.85% подвыборки одного продавца.
Доля просрочек продавца =
DIVIDE(
    [Просрочки продавца],
    [Заказы продавца]
)

// Формат — число с одним десятичным знаком. Только просроченные заказы.
// Сверены лидер 8 дней и общий итог 7 дней.
Медианная задержка продавца, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delay_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[seller_count] = 1,
    'mart order_delivery'[is_late] = TRUE(),
    TREATAS(
        VALUES('mart order_seller'[order_id]),
        'mart order_delivery'[order_id]
    )
)

Объём выборки продавца =
IF(
    [Заказы продавца] < 100,
    "Менее 100 заказов",
    "От 100 заказов"
)

// Основной анализ категорий. Одна известная категория, неизвестных позиций нет.
// Сверены общий итог 94358/6422 и bed_bath_table 9069/684/7.54%.
Заказы категории =
CALCULATE(
    [Пригодные заказы],
    'mart order_delivery'[known_category_count] = 1,
    'mart order_delivery'[unknown_category_item_count] = 0,
    TREATAS(
        VALUES('mart order_category'[order_id]),
        'mart order_delivery'[order_id]
    )
)

Просрочки категории =
COALESCE(
    CALCULATE(
        [Заказы категории],
        'mart order_delivery'[is_late] = TRUE()
    ),
    0
)

Доля просрочек категории =
DIVIDE(
    [Просрочки категории],
    [Заказы категории]
)

// Только просроченные заказы с одной известной категорией.
// Формат — число с одним десятичным знаком.
// Сверены audio 7 дней, home_confort 9 дней и fashion_underwear_beach 7 дней.
Медианная задержка категории, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delay_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[known_category_count] = 1,
    'mart order_delivery'[unknown_category_item_count] = 0,
    'mart order_delivery'[is_late] = TRUE(),
    TREATAS(
        VALUES('mart order_category'[order_id]),
        'mart order_delivery'[order_id]
    )
)

Объём выборки категории =
IF(
    [Заказы категории] < 100,
    "Менее 100 заказов",
    "От 100 заказов"
)

// Основной анализ отзывов. Используется выбранный отзыв и допуск из SQL.
// По группам задержки число отзывов, покрытие и средняя оценка сверены с SQL.
Пригодные отзывы =
CALCULATE(
    COUNTROWS('mart order_delivery'),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_review_eligible] = TRUE()
)

// Формат — процент с двумя десятичными знаками.
Покрытие отзывами =
DIVIDE(
    [Пригодные отзывы],
    [Пригодные заказы]
)

// Формат — число с двумя десятичными знаками.
Средняя оценка =
CALCULATE(
    AVERAGE('mart order_delivery'[review_score]),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_review_eligible] = TRUE()
)

// Оценки 1–2 среди пригодных отзывов, тот же знаменатель отбора, что в SQL.
// Сверены числа 8258, 267, 81, 15, 8 и доли 9.25%, 18.59%, 20.45%, 26.32%, 42.11%.
Низкие оценки =
COALESCE(
    CALCULATE(
        [Пригодные отзывы],
        KEEPFILTERS('mart order_delivery'[review_score] IN { 1, 2 })
    ),
    0
)

// Формат — процент, два десятичных знака.
Доля низких оценок =
DIVIDE(
    [Низкие оценки],
    [Пригодные отзывы]
)

Объём отзывов =
IF(
    [Пригодные отзывы] < 30,
    "Менее 30 отзывов",
    "От 30 отзывов"
)

// Для распределения оценок 1–5 внутри группы доставки.
// Формат — процент, два десятичных знака. Для оценки 5 сверены 62.28%/40.57%.
Доля оценки в группе =
DIVIDE(
    [Пригодные отзывы],
    CALCULATE(
        [Пригодные отзывы],
        REMOVEFILTERS('mart order_delivery'[review_score])
    )
)

// Пригодные отзывы для основной подвыборки одной известной категории.
// Матрица создана; числа baby 2474/58 и auto 3479/83 сверены с SQL.
Пригодные отзывы категории =
CALCULATE(
    [Пригодные отзывы],
    'mart order_delivery'[known_category_count] = 1,
    'mart order_delivery'[unknown_category_item_count] = 0,
    TREATAS(
        VALUES('mart order_category'[order_id]),
        'mart order_delivery'[order_id]
    )
)

// Формат — процент, два десятичных знака.
Покрытие отзывами категории =
DIVIDE(
    [Пригодные отзывы категории],
    [Заказы категории]
)

Доля низких оценок категории =
CALCULATE(
    [Доля низких оценок],
    'mart order_delivery'[known_category_count] = 1,
    'mart order_delivery'[unknown_category_item_count] = 0,
    TREATAS(
        VALUES('mart order_category'[order_id]),
        'mart order_delivery'[order_id]
    )
)

// Фильтр матрицы, 1 при наличии минимум 30 отзывов в каждой группе.
// REMOVEFILTERS снимает фильтр столбца матрицы для проверки обеих групп.
Категория для сравнения =
VAR OnTimeReviews =
    CALCULATE(
        [Пригодные отзывы категории],
        REMOVEFILTERS('mart order_delivery'[Группа доставки]),
        'mart order_delivery'[is_late] = FALSE()
    )
VAR LateReviews =
    CALCULATE(
        [Пригодные отзывы категории],
        REMOVEFILTERS('mart order_delivery'[Группа доставки]),
        'mart order_delivery'[is_late] = TRUE()
    )
RETURN
    IF(OnTimeReviews >= 30 && LateReviews >= 30, 1, 0)

// Отбор матрицы штатов: минимум 30 пригодных отзывов в каждой группе.
// Матрица создана, 13 штатов; для SP сверены 38427/701 отзыв.
Штат для сравнения =
VAR OnTimeReviews =
    CALCULATE(
        [Пригодные отзывы],
        REMOVEFILTERS('mart order_delivery'[Группа доставки]),
        'mart order_delivery'[is_late] = FALSE()
    )
VAR LateReviews =
    CALCULATE(
        [Пригодные отзывы],
        REMOVEFILTERS('mart order_delivery'[Группа доставки]),
        'mart order_delivery'[is_late] = TRUE()
    )
RETURN
    IF(OnTimeReviews >= 30 && LateReviews >= 30, 1, 0)
