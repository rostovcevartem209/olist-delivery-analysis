// Создавать меры в Power BI Desktop по одной.
// Имя импортированной таблицы в текущем отчёте — mart order_delivery.
// Все семь мер ниже сверены пользователем с SQL по карточкам.

Всего заказов = COUNTROWS('mart order_delivery')

Пригодные заказы =
CALCULATE(
    COUNTROWS('mart order_delivery'),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

Просроченные заказы =
CALCULATE(
    COUNTROWS('mart order_delivery'),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_late] = TRUE()
)

// Формат меры — процент, два десятичных знака.
Доля просрочек =
DIVIDE(
    [Просроченные заказы],
    [Пригодные заказы]
)

// Сверены медиана доставки 10, P90 23, медианная задержка 7 дней.
// Формат — число. Единица измерения — календарные дни.
Медиана доставки, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delivery_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

P90 доставки, дней =
CALCULATE(
    PERCENTILE.INC('mart order_delivery'[delivery_days], 0.9),
    'mart order_delivery'[is_delivery_eligible] = TRUE()
)

Медианная задержка, дней =
CALCULATE(
    MEDIAN('mart order_delivery'[delay_days]),
    'mart order_delivery'[is_delivery_eligible] = TRUE(),
    'mart order_delivery'[is_late] = TRUE()
)

// Отметка малого объёма в контексте штата, категории или продавца.
// Мера добавлена в таблицу и подсказки. Для AP сверены 67 заказов
// и отметка Менее 100 заказов. Медианная задержка отображается с одним знаком.
Объём выборки =
IF(
    [Пригодные заказы] < 100,
    "Менее 100 заказов",
    "От 100 заказов"
)

// Доля просрочек штата в просрочках всех штатов.
// Остальные фильтры отчёта сохраняются.
// Сверены SP 27.85%, RJ 22.88%, MG 7.94% и итог 100%.
Вклад в просрочки =
DIVIDE(
    [Просроченные заказы],
    CALCULATE(
        [Просроченные заказы],
        REMOVEFILTERS('mart order_delivery'[customer_state])
    )
)

// Накопленный вклад штатов по числу просрочек по убыванию.
// При совпадении количества порядок определяется кодом штата по возрастанию.
// Сверены SP 27.85%, RJ 50.73%, MG 58.68%, BA 64.74% и итог 100%.
Накопленный вклад =
VAR CurrentState =
    SELECTEDVALUE('mart order_delivery'[customer_state])
VAR CurrentLateOrders =
    [Просроченные заказы]
VAR StateCounts =
    CALCULATETABLE(
        ADDCOLUMNS(
            VALUES('mart order_delivery'[customer_state]),
            "LateOrders", [Просроченные заказы]
        ),
        REMOVEFILTERS('mart order_delivery'[customer_state])
    )
VAR CumulativeLateOrders =
    SUMX(
        FILTER(
            StateCounts,
            [LateOrders] > CurrentLateOrders
                || (
                    [LateOrders] = CurrentLateOrders
                        && 'mart order_delivery'[customer_state] <= CurrentState
                )
        ),
        [LateOrders]
    )
RETURN
    IF(
        ISINSCOPE('mart order_delivery'[customer_state]),
        DIVIDE(
            CumulativeLateOrders,
            CALCULATE(
                [Просроченные заказы],
                REMOVEFILTERS('mart order_delivery'[customer_state])
            )
        ),
        [Вклад в просрочки]
    )
